[
  {
    "name": "instructions",
    "type": "group",
    "label": "Instructions",
    "importance": "high",
    "optional": true,
    "fields": [
      {
        "name": "enabled",
        "type": "boolean",
        "label": "Show instructions",
        "default": false
      },
      {
        "name": "text",
        "type": "text",
        "widget": "html",
        "label": "Instructions text",
        "importance": "high",
        "optional": true,
        "tags": [
          "p",
          "br",
          "strong",
          "em",
          "ul",
          "ol",
          "li"
        ]
      },
      {
        "name": "displayMode",
        "type": "select",
        "label": "Display mode",
        "default": "both",
        "options": [
          {
            "value": "intro",
            "label": "Intro only"
          },
          {
            "value": "tab",
            "label": "Tab only"
          },
          {
            "value": "both",
            "label": "Intro and tab"
          }
        ]
      },
      {
        "name": "introButtonLabel",
        "type": "text",
        "label": "Intro button label",
        "default": "Start",
        "optional": true
      },
      {
        "name": "tabButtonLabel",
        "type": "text",
        "label": "Tab button label",
        "default": "Instructions",
        "optional": true
      },
      {
        "name": "startCollapsed",
        "type": "boolean",
        "label": "Collapse tab on load",
        "default": true
      },
      {
        "name": "animation",
        "type": "group",
        "label": "Animation",
        "importance": "low",
        "optional": true,
        "fields": [
          {
            "name": "introDuration",
            "type": "number",
            "label": "Intro curtain duration",
            "description": "Opening/closing speed for the intro curtain in milliseconds.",
            "default": 600,
            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabDuration",
            "type": "number",
            "label": "Tab open/close duration",
            "description": "Opening/closing speed for the instructions tab in milliseconds.",
            "default": 600,
            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabClosedOffset",
            "type": "number",
            "label": "Tab closed extra offset",
            "description": "Extra offset (in px) applied when the tab is closed. 0 keeps it flush; higher values hide it more.",
            "default": 0,
            "min": 0,
            "max": 5,
            "step": 1,
            "unit": "px"
          }
        ]
      }
    ]
  },
  {
    "name": "context",
    "type": "group",
    "label": "Context (optional)",
    "importance": "low",
    "optional": true,
    "fields": [
      {
        "name": "text",
        "type": "text",
        "widget": "html",
        "label": "Context text",
        "importance": "medium",
        "optional": true,
        "description": "Optional supporting text shown beside the question.",
        "tags": [
          "p",
          "br",
          "strong",
          "em",
          "ul",
          "ol",
          "li",
          "code"
        ]
      },
      {
        "name": "media",
        "type": "group",
        "label": "Context image",
        "importance": "medium",
        "optional": true,
        "fields": [
          {
            "name": "type",
            "type": "library",
            "label": "Image",
            "importance": "medium",
            "options": [
              "H5P.Image 1.1"
            ],
            "optional": true,
            "description": "Optional image shown beside the question."
          },
          {
            "name": "disableImageZooming",
            "type": "boolean",
            "label": "Disable image zooming",
            "importance": "low",
            "default": false,
            "optional": true,
            "widget": "showWhen",
            "showWhen": {
              "rules": [
                {
                  "field": "type",
                  "equals": "H5P.Image 1.1"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  {
    "name": "paragraphs",
    "label": "Paragraphs",
    "type": "list",
    "entity": "paragraph",
    "min": 3,
    "field": {
      "name": "paragraph",
      "label": "Paragraph",
      "importance": "high",
      "type": "text",
      "widget": "html",
      "enterMode": "div",
      "tags": [
        "strong",
        "em",
        "u",
        "ul",
        "ol",
        "h2",
        "h3",
        "hr",
        "pre",
        "code"
      ]
    }
  },
  {
    "name": "overallFeedback",
    "type": "group",
    "label": "Overall Feedback",
    "importance": "low",
    "expanded": true,
    "fields": [
      {
        "name": "overallFeedback",
        "type": "list",
        "widgets": [
          {
            "name": "RangeList",
            "label": "Default"
          }
        ],
        "importance": "high",
        "label": "Define custom feedback for any score range",
        "description": "Click the \"Add range\" button to add as many ranges as you need. Example: 0-20% Bad score, 21-91% Average Score, 91-100% Great Score!",
        "entity": "range",
        "min": 1,
        "defaultNum": 1,
        "optional": true,
        "field": {
          "name": "overallFeedback",
          "type": "group",
          "importance": "low",
          "fields": [
            {
              "name": "from",
              "type": "number",
              "label": "Score Range",
              "min": 0,
              "max": 100,
              "default": 0,
              "unit": "%"
            },
            {
              "name": "to",
              "type": "number",
              "min": 0,
              "max": 100,
              "default": 100,
              "unit": "%"
            },
            {
              "name": "feedback",
              "type": "text",
              "label": "Feedback for defined score range",
              "importance": "low",
              "placeholder": "Fill in the feedback",
              "optional": true
            },
            {
              "name": "appearance",
              "type": "group",
              "label": "Appearance settings",
              "importance": "low",
              "expanded": false,
              "optional": true,
              "fields": [
                {
                  "name": "feedbackLeadText",
                  "type": "text",
                  "label": "Highlighted lead text",
                  "importance": "low",
                  "placeholder": "e.g. Correct! or Incorrect",
                  "optional": true
                },
                {
                  "name": "feedbackLeadBold",
                  "type": "boolean",
                  "label": "Bold lead text",
                  "importance": "low",
                  "default": true
                },
                {
                  "name": "feedbackTextAlign",
                  "type": "select",
                  "label": "Text alignment",
                  "description": "Only used when no feedback image is set. With an image, text alignment follows image position (left/right: left aligned, above: centered).",
                  "importance": "low",
                  "default": "left",
                  "options": [
                    {
                      "value": "left",
                      "label": "Left"
                    },
                    {
                      "value": "center",
                      "label": "Center"
                    },
                    {
                      "value": "right",
                      "label": "Right"
                    }
                  ]
                },
                {
                  "name": "feedbackImage",
                  "type": "image",
                  "label": "Feedback image",
                  "importance": "low",
                  "optional": true
                },
                {
                  "name": "feedbackImagePosition",
                  "type": "select",
                  "label": "Image position",
                  "importance": "low",
                  "default": "left",
                  "options": [
                    {
                      "value": "above",
                      "label": "Above text"
                    },
                    {
                      "value": "left",
                      "label": "Left of text"
                    },
                    {
                      "value": "right",
                      "label": "Right of text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Behavioural settings",
    "importance": "low",
    "description": "These options will let you control how the task behaves.",
    "fields": [
      {
        "name": "scoringMode",
        "label": "Scoring mode",
        "description": "Decide whether to give points for each correctly placed paragraph or for each paragraph that is placed immediately after the paragraph it is supposed to be placed after (\"correct sequence\")",
        "type": "select",
        "importance": "low",
        "default": "positions",
        "options": [
          {
            "value": "positions",
            "label": "Correctly placed paragraph"
          },
          {
            "value": "transitions",
            "label": "Correct sequence"
          }
        ]
      },
      {
        "name": "applyPenalties",
        "label": "Apply penalties",
        "description": "Decide whether to deduce a point for each paragraph that's not positioned correctly.",
        "type": "boolean",
        "importance": "low",
        "default": true,
        "widget": "showWhen",
        "showWhen": {
          "rules": [
            {
              "field": "scoringMode",
              "equals": "positions"
            }
          ]
        }
      },
      {
        "name": "duplicatesInterchangeable",
        "label": "Duplicate parapraphs interchangeable",
        "description": "If set, when checking the answer, duplicate paragraphs will be treated as identical if their plain text is equal.",
        "type": "boolean",
        "importance": "low",
        "default": true,
        "optional": true
      },
      {
        "name": "addButtonsForMovement",
        "label": "Add buttons for movement",
        "description": "On mobile devices, buttons for moving paragraphs can offer an extra accessibility benefit. If you prefer, you can deactivate them here.",
        "type": "boolean",
        "importance": "low",
        "default": true,
        "optional": true
      },
      {
        "name": "showScorePoints",
        "type": "boolean",
        "label": "Show score points",
        "description": "Show points earned for each paragraph or transition when checking answers.",
        "importance": "low",
        "default": false
      },
      {
        "name": "enableRetry",
        "label": "Enable \"Retry\" button",
        "type": "boolean",
        "importance": "low",
        "default": true,
        "optional": true
      },
      {
        "name": "enableSolutionsButton",
        "label": "Enable \"Show Solution\" button",
        "type": "boolean",
        "importance": "low",
        "default": true,
        "optional": true
      }
    ]
  },
