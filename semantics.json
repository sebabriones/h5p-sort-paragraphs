        "default": "Grabbed"
      },
      {
        "name": "moved",
        "type": "text",
        "label": "Moved",
        "importance": "low",
        "default": "Moved"
      },
      {
        "name": "dropped",
        "type": "text",
        "label": "Dropped",
        "importance": "low",
        "default": "Dropped"
      },
      {
        "name": "reorderCancelled",
